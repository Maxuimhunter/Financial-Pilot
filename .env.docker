# MySQL Root Password (for container setup)
DB_ROOT_PASSWORD=rootpassword

# MySQL Database Configuration
# These credentials are used by both the app and phpMyAdmin
DB_HOST=mysql
DB_PORT=3306
DB_USER=budget_user
DB_PASSWORD=budget_password
DB_NAME=budget_tracker

# OpenAI API Key for ChatGPT integration (optional - not used if using local AI)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Local AI Model Configuration (SmolLM2)
# Use host.docker.internal to access host services from Docker container
AI_API_ENDPOINT=http://host.docker.internal:12434/engines/v1/chat/completions
